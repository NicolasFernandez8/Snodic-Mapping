# Copiar a .env y completar. NUNCA subir .env a Git.

# PostgreSQL (usuario de aplicación, sin superusuario). Desde Docker en la red snodic-postgres_default: host "snodic-postgres".
DATABASE_URL=postgres://snodic_app:CAMBIAR@localhost:5432/snodic

# Google Places API (New) — https://console.cloud.google.com → APIs → "Places API (New)"
GOOGLE_MAPS_API_KEY=

# Notion — integración interna (https://www.notion.so/my-integrations) compartida con la base de prospectos
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Opcional: renombrar propiedades. Campos: name, locality, region, category, address, phone, website, email,
# instagram, google_maps_url, reviews_url, rating, reviews_count, status
# NOTION_PROPERTY_MAP={"name":"Nombre","locality":"Localidad"}

# Agentes 3 y 4: "manual" (sin IA, prompt listo para copiar) o "anthropic" (API de pago por uso)
LLM_PROVIDER=manual
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pipeline diario (cron) y zona horaria
WORKER_CRON=0 9 * * *
TZ=Europe/Madrid

# Opcional
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# APP_USER_AGENT=Snodic-Mapping/0.1 (contacto@tu-dominio)

# Acceso a la UI (HTTP Basic). Si se deja vacío, la UI queda sin contraseña (solo usar detrás de Tailscale).
APP_BASIC_AUTH=

# --- Solo para docker compose (host "snodic-postgres" dentro de la red snodic-postgres_default) ---
DATABASE_URL_DOCKER=postgres://snodic_app:CAMBIAR@snodic-postgres:5432/snodic
# Migraciones: usuario con permiso CREATE sobre la base (ver docs/SETUP.md)
DATABASE_URL_MIGRATE=postgres://snodic_app:CAMBIAR@snodic-postgres:5432/snodic
