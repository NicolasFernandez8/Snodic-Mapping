# Copiar a .env y completar. NUNCA subir .env a Git.

# PostgreSQL: usuario propio de esta app (snodic_mapping), sin superusuario. Ver docs/SETUP.md §2. Desde Docker en la red snodic-postgres_default: host "snodic-postgres".
DATABASE_URL=postgres://snodic_mapping:CAMBIAR@localhost:5432/snodic

# NO USAR (requiere facturación). Snodic trabaja en modo gratuito con OpenStreetMap.
# GOOGLE_MAPS_API_KEY=

# Notion — integración interna (https://www.notion.so/my-integrations) compartida con la base de prospectos
NOTION_TOKEN=
# Pegá el link de la base "Snodic - Mapping" (Privado) tal cual lo copiás de Notion, o solo su ID.
NOTION_DATABASE_ID=
# Columna numérica correlativa: las filas nuevas siguen desde el número más alto (p. ej. 244, 245…).
# NOTION_NUM_PROPERTY=Num
# Opcional: renombrar propiedades (por defecto ya coinciden con la base de Snodic). Campos: name, business_days,
# business_hours, rating, ready, locality, website, phone, address, contact_info, region, category, email, type, google_maps_url
# NOTION_PROPERTY_MAP={"name":"Nombre","locality":"Localidad"}

# Agentes 3 y 4: "manual" = gratis (prompt listo para copiar en tu app de Claude).
# "ollama" = IA local y gratis en esta PC (se activa también desde Ajustes › IA). "anthropic" es de pago: NO USAR.
LLM_PROVIDER=manual
# IA local (Ollama): desde Docker la PC es host.docker.internal. Modelo recomendado para 6 GB de video: qwen2.5:7b
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
# Contexto en tokens (8192 por defecto; 6144 = un poco más rápido en placas de 6 GB, pero menos reseñas por prompt)
# OLLAMA_NUM_CTX=8192
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Pipeline diario (cron) y zona horaria
WORKER_CRON=0 9 * * *
TZ=Europe/Madrid

# Opcional
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# APP_USER_AGENT=Snodic-Mapping/0.1 (contacto@tu-dominio)


# --- Solo para docker compose (host "snodic-postgres" dentro de la red snodic-postgres_default) ---
DATABASE_URL_DOCKER=postgres://snodic_mapping:CAMBIAR@snodic-postgres:5432/snodic
# Migraciones: usuario con permiso CREATE sobre la base (ver docs/SETUP.md)
DATABASE_URL_MIGRATE=postgres://snodic_mapping:CAMBIAR@snodic-postgres:5432/snodic

# Avisos a n8n (gratis, local): URL de un nodo Webhook. Eventos: daily_summary, stage_changed, audit_viewed.
# Desde Docker en la misma red: http://n8n:5678/webhook/snodic-mapping
N8N_WEBHOOK_URL=

# URL pública para los links de mini-auditoría (ej. la de Tailscale o el quick tunnel). Vacío = la del navegador.
APP_PUBLIC_URL=
